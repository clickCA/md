---
import Icon from "./Icon.astro";
---

<section id="download" class="scroll-mt-8 py-20 text-center">
  <h2 class="text-3xl font-bold tracking-tight text-balance text-heading sm:text-4xl">
    Start with a blank page.
  </h2>
  <p class="mx-auto mt-3 max-w-md text-pretty text-[15px] leading-relaxed text-muted-foreground">
    Your ideas deserve a better place to live. Download free — no account, no complicated setup.
  </p>
  <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
    <a
      href="https://github.com/clickCA/md/releases/latest/download/md-app-android-arm64.apk"
      class="flex items-center gap-2 rounded-md bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground hover:opacity-90"
    >
      <Icon name="download" class="size-4" />
      Download for Android
    </a>
    <a
      href="https://github.com/clickCA/md/releases"
      class="rounded-md border border-border bg-card px-5 py-2.5 text-sm font-medium text-foreground hover:bg-accent"
    >
      All releases
    </a>
  </div>
  <p class="mt-4 font-mono text-xs text-muted-foreground">
    arm64 · Android 7.0+ · v0.1.0 · self-signed APK, sideload to install
  </p>
</section>

<footer class="flex items-center justify-between border-t border-border py-4 font-mono text-[11px] text-muted-foreground">
  <span>md — personal markdown vault</span>
  <span>tauri 2 · rust core · standard git remotes</span>
</footer>
