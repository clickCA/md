# Maintainer: clickCA <chanakorn.aramsak@gmail.com>
pkgname=md-app
pkgver=0.1.0
pkgrel=3
# GitHub release tag the .deb comes from (app version and tag diverge on
# pre-releases: artifacts stay 0.1.0, the tag carries the alpha suffix)
_tag=v0.1.0-alpha.2
pkgdesc="Local-first Markdown vault with git sync"
arch=('x86_64')
url="https://github.com/clickCA/md"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3')
source=("md-app_${pkgver}_amd64.deb::https://github.com/clickCA/md/releases/download/${_tag}/md-app_${pkgver}_amd64.deb")
sha256sums=('66ef25bb599f0103678f5dd4ee8a3af930de628a0ed1150a2b5b27ddd68e4462')
options=('!strip')

package() {
  cd "$srcdir"
  ar x *.deb
  tar -xf data.tar.* -C "$pkgdir"
}
