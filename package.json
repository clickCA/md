{
  "name": "md",
  "private": true,
  "version": "0.1.0-alpha.1",
  "description": "Local-first Markdown vault with real Git sync (monorepo root)",
  "scripts": {
    "dev": "pnpm --filter md-app dev",
    "dev:landing": "pnpm --filter md-landing dev",
    "build": "pnpm --filter md-app build",
    "build:landing": "pnpm --filter md-landing build",
    "test": "pnpm --filter md-app test:run",
    "lint": "pnpm --filter md-app lint",
    "format": "pnpm --filter md-app format",
    "format:check": "pnpm --filter md-app format:check",
    "typecheck": "pnpm --filter md-app typecheck"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=26"
  }
}
